# Optionnel : si renseigné, l'app synchronise via Supabase entre tes appareils.
# Sinon, l'app fonctionne en localStorage uniquement.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
# Identifiant de "workspace" partagé entre tous tes appareils.
# N'importe quelle chaîne stable — par défaut "default".
VITE_WORKSPACE_ID=default
